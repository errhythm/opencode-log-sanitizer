{
  "name": "opencode-log-sanitizer",
  "version": "1.4.0",
  "description": "Sanitizes pasted logs before sending them to AI by redacting long quoted strings, JWT tokens, bcrypt hashes, and base64 blobs to reduce token usage and remove irrelevant noise.",
  "author": {
    "name": "Ehsanur Rahman Rhythm",
    "email": "errhythm.me@gmail.com"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "logs",
    "log-sanitizer",
    "ai-tokens",
    "prompt-sanitizer",
    "jwt-redaction",
    "log-cleaner"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "bun run build:v1 && bun run build:v2 && tsc -p tsconfig.build.json --emitDeclarationOnly",
    "build:v1": "bun build src/dispatch.ts --outfile dist/index.js --target bun",
    "build:v2": "bun build src/v2/index.ts --outfile dist/v2/index.js --target bun",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "exports": {
    ".": {
      "types": "./dist/dispatch.d.ts",
      "default": "./dist/index.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/errhythm/opencode-log-sanitizer.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@opencode-ai/plugin": "latest",
    "@opencode-ai/sdk": "latest",
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "8.47.0",
    "@typescript-eslint/parser": "8.47.0",
    "bun-types": "latest",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "^5.1.3",
    "prettier": "^3.2.4",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.47.0",
    "vitest": "^3.2.4"
  }
}
