{
  "name": "opencode-log-sanitizer-v2",
  "version": "0.1.0",
  "description": "Sanitizes pasted logs before sending them to AI by redacting long quoted strings, JWT tokens, bcrypt hashes, and base64 blobs to reduce token usage and remove irrelevant noise.",
  "author": {
    "name": "Ehsanur Rahman Rhythm",
    "email": "errhythm.me@gmail.com"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "logs",
    "log-sanitizer",
    "ai-tokens",
    "prompt-sanitizer",
    "jwt-redaction",
    "log-cleaner"
  ],
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "bun build ./src/index.ts --outdir dist --target bun --format esm && tsc -p tsconfig.build.json --emitDeclarationOnly",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/errhythm/opencode-log-sanitizer.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "src/version.ts"
  ],
  "devDependencies": {
    "@opencode/plugin": "2.0.16",
    "@opencode/schema": "2.0.16",
    "@types/node": "^22.0.0",
    "typescript": "~5.9.3",
    "vitest": "^3.2.4"
  },
  "peerDependencies": {
    "@opencode/plugin": ">=2.0.0"
  }
}
