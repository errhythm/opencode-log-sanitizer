#!/usr/bin/env bash
#MISE description="Build the project"
#MISE depends=["setup"]
#MISE sources=["src/**/*"]
#MISE outputs=["dist/index.js", "dist/v2/index.js", "dist/index.d.ts"]

bun build ./src/dispatch.ts --outfile dist/index.js --target bun
bun build ./src/v2/index.ts --outfile dist/v2/index.js --target bun

# Generate TypeScript declaration files (.d.ts) for npm consumers
npx tsc --project tsconfig.build.json
